# ─────────────────────────────────────────────────────────────
# Local setup: copy this file to `.env` and fill in real values.
# Only `.env.example` belongs in GitHub — never commit `.env`.
# ─────────────────────────────────────────────────────────────

# MySQL (encode special chars in password, e.g. @ → %40)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/insyncx"

# App URL (used by NextAuth callbacks & Stripe redirect URLs)
NEXTAUTH_URL="http://localhost:3000"

# Secret for sessions (generate: openssl rand -base64 32)
# Auth.js v5 reads AUTH_SECRET; NEXTAUTH_* kept for compatibility
AUTH_SECRET=""
NEXTAUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Google sign-in (optional) — Google Cloud Console → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_CLIENT_ID=""

# Cloudinary (optional, for uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email (optional)
RESEND_API_KEY=""

# Platform / seed (see prisma seed if used)
PLATFORM_COMMISSION_PERCENT=10
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-after-seed"
